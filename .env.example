# ==============================================================
# ABHYAS AI — CONFIGURATION & ENVIRONMENT VARIABLES
# ==============================================================

# Flask Core
FLASK_APP=app.py
FLASK_ENV=development
FLASK_SECRET_KEY=abhyas_ai_secret_key_2026
SECRET_KEY=dev_secret_key_change_me

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REASONING_MODEL=gemini-3.1-pro-preview
EMBEDDING_MODEL=gemini-embedding-001

# LLM Provider Architecture ('gemini', 'local', 'auto')
LLM_PROVIDER=gemini

# Optional Local Inference (Ollama / vLLM with Qwen 8B)
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen3:8b

# RAG & Chroma Cloud
# Get your key from https://www.trychroma.com/asmit01052005/aws-us-east-1/abhyasAI/sdk?tab=env
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=688bc2df-d727-4a69-9f2e-5fa46471ce1c
CHROMA_DATABASE=abhyasAI

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Relational Persistence (SQLite default, PostgreSQL compatible)
DATABASE_URL=sqlite:///abhyas.db

# Hackathon Demo Mode
DEMO_MODE=true
